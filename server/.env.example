# DevaMart API Server - copy to .env and fill in your own values
PORT=4000

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: path to the SQLite database file (defaults to server/data/devamart.db)
# DB_PATH=/tmp/devamart.db
